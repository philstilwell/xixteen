{
  "name": "xixteen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-question-bank.mjs && node scripts/build-daily-quizzes.mjs",
    "validate": "node scripts/validate-question-bank.mjs",
    "audit": "node scripts/audit-question-bank.mjs",
    "export:d1": "node scripts/export-d1-seed.mjs",
    "db:seed": "node scripts/export-d1-seed.mjs",
    "pdf:curriculum": "python3 scripts/build-curriculum-pdf.py",
    "dev:pages": "npx wrangler pages dev . --compatibility-date=2026-06-18",
    "articles:build": "node scripts/build-article-categories.mjs",
    "articles:check": "node scripts/build-article-categories.mjs --check",
    "check": "npm run generate && npm run validate && npm run audit && npm run articles:check && npm run instructors:check && npm run site:check",
    "instructors:build": "node scripts/build-instructor-pages.mjs",
    "instructors:check": "node scripts/build-instructor-pages.mjs --check",
    "pdf:teaching-packs": "python3 scripts/build-teaching-pack-pdfs.py",
    "site:check": "node scripts/check-site.mjs"
  }
}
